[Unit]
Description=Encrypted Identity staging snapshot
After=docker.service network-online.target
Wants=network-online.target
ConditionPathExists=/var/lib/shadowops/identity-staging/backup-vault
[Service]
Type=oneshot
ExecStart=/usr/local/sbin/shadowops-identity-staging-backup scheduled
User=root
Group=root
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/shadowops/identity-staging
