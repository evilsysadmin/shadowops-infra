# Only the fixed root-owned Identity staging wrapper; never Docker or a shell.
# The wrapper validates exactly: deploy sha256:<64hex> <40hex SHA> ocid1.vault.<...>
Cmnd_Alias SHADOWOPS_IDENTITY_STAGING = /usr/local/sbin/shadowops-identity-staging deploy *
ocarun ALL=(root) NOPASSWD: SHADOWOPS_IDENTITY_STAGING
# Backup only; restore remains an explicit root operator operation.
Cmnd_Alias SHADOWOPS_IDENTITY_BACKUP = /usr/local/sbin/shadowops-identity-staging-backup backup *
ocarun ALL=(root) NOPASSWD: SHADOWOPS_IDENTITY_BACKUP

# Fixed Atlas preparation and encrypted backup only; no general shell or restore.
Cmnd_Alias SHADOWOPS_IDENTITY_ATLAS_PREPARE = /usr/local/sbin/shadowops-identity-atlas-prepare prepare *
ocarun ALL=(root) NOPASSWD: SHADOWOPS_IDENTITY_ATLAS_PREPARE
Cmnd_Alias SHADOWOPS_IDENTITY_ATLAS_BACKUP = /usr/local/sbin/shadowops-identity-atlas-backup backup
ocarun ALL=(root) NOPASSWD: SHADOWOPS_IDENTITY_ATLAS_BACKUP

# Fixed Atlas read-only preflight; wrapper validates image digest and SHA.
Cmnd_Alias SHADOWOPS_IDENTITY_ATLAS_PREFLIGHT = /usr/local/sbin/shadowops-identity-atlas-preflight preflight *
ocarun ALL=(root) NOPASSWD: SHADOWOPS_IDENTITY_ATLAS_PREFLIGHT
