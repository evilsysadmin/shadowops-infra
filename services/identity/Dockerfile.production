# Production Identity is a separate, opt-in binary. No production credentials
# or private configuration ever enter the build context or image.
FROM --platform=$BUILDPLATFORM golang:1.27.4-alpine AS build
ARG TARGETOS
ARG TARGETARCH
ARG IDENTITY_SOURCE_SHA
ENV GOTOOLCHAIN=local
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download && go mod verify
COPY . .
RUN printf '%s' "$IDENTITY_SOURCE_SHA" | grep -Eq '^[0-9a-f]{40}$' && \
    test "$(go env GOVERSION)" = go1.27.4 && \
    CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath \
      -ldflags="-s -w" -o /out/identity-production ./cmd/service-production && \
    test "$(go version /out/identity-production)" = "/out/identity-production: go1.27.4" && \
    go version -m /out/identity-production | grep -Fqx "$(printf '\tbuild\tGOOS=%s' "$TARGETOS")" && \
    go version -m /out/identity-production | grep -Fqx "$(printf '\tbuild\tGOARCH=%s' "$TARGETARCH")"

FROM scratch
ARG IDENTITY_SOURCE_SHA
LABEL org.opencontainers.image.source="https://github.com/evilsysadmin/shadowops-infra" \
      org.opencontainers.image.revision="$IDENTITY_SOURCE_SHA" \
      org.opencontainers.image.title="ShadowOps Identity production candidate"
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=build /out/identity-production /app/identity-production
USER 65532:65532
EXPOSE 9443
ENV IDENTITY_PRODUCTION_CONFIG_FILE=/run/secrets/identity-production.json
# No CMD: without an explicit preflight/serve-unready/serve-ready mode the
# binary exits nonzero. The image never starts authentication implicitly.
ENTRYPOINT ["/app/identity-production"]
